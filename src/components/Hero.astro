---
import { site } from '../data/site';
const { hero } = site;
---
<section class="hero" id="top">
  <div class="wrap hero-copy">
    <p class="kicker">{hero.kicker}</p>
    <h1 set:html={hero.titleHtml}></h1>
    <p class="hero-lead">{hero.lead}</p>
    <div class="hero-actions">
      <a class="btn" href={hero.primaryCta.href}>{hero.primaryCta.label}</a>
      <a class="btn btn-ghost" href={hero.secondaryCta.href}>{hero.secondaryCta.label}</a>
    </div>
  </div>
  <div class="hero-photo" role="img" aria-label="Deadlift on the platform">
    <span class="hero-caption">{hero.caption}</span>
  </div>
</section>

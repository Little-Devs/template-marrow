---
import { site } from '../data/site';
const links = site.nav.filter((item) => site.sections[item.section]);
---
<header class="site-header">
  <div class="wrap nav">
    <a class="logo" href="#top"><span class="logo-mark">{site.logo.mark}</span><span>{site.logo.text}</span></a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" id="nav-toggle">Menu</button>
    <nav aria-label="Primary">
      <ul class="nav-list" id="primary-nav">
        {links.map((item) => (<li><a href={item.href}>{item.label}</a></li>))}
      </ul>
    </nav>
  </div>
</header>
<script>
  const toggle = document.getElementById('nav-toggle');
  const list = document.getElementById('primary-nav');
  toggle?.addEventListener('click', () => {
    const open = list?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
</script>

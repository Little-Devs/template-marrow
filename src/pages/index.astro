---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Board from '../components/Board.astro';
import Programming from '../components/Programming.astro';
import Floor from '../components/Floor.astro';
import Coaches from '../components/Coaches.astro';
import Contact from '../components/Contact.astro';
import { site } from '../data/site';
---
<BaseLayout>
  <Header />
  <main id="main">
    {site.sections.hero && <Hero />}
    {site.sections.board && <Board />}
    {site.sections.programming && <Programming />}
    {site.sections.floor && <Floor />}
    {site.sections.coaches && <Coaches />}
    {site.sections.contact && <Contact />}
  </main>
  <Footer />
</BaseLayout>
